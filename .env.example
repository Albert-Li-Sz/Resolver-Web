# GitHub Actions 构建的发布镜像版本。
RESOLVER_IMAGE_TAG=main
# 可选管理员密码；留空不启用登录，设置后用户名固定为 admin。
RESOLVER_ADMIN_KEY=
# 默认监听全部 IPv4 网卡，可由部署者改为指定监听地址。
RESOLVER_BIND_ADDRESS=0.0.0.0
RESOLVER_PORT=4173
# 默认开放所有来源。restricted 启用应用内的网络限制。
RESOLVER_NETWORK_POLICY=open
RESOLVER_TRUST_PROXY=true
RESOLVER_ALLOWED_ORIGINS=
RESOLVER_SECURITY_HEADERS=false
# restricted 模式下额外允许的数据源，多个用英文逗号分隔。
# RESOLVER_FEED_ORIGINS=http://192.168.1.20:8080
RESOLVER_FEED_ORIGINS=

# restricted 模式下额外允许的素材来源（精确 origin，逗号分隔）。
RESOLVER_MEDIA_ORIGINS=
