# GitHub Actions 构建的发布镜像版本。
RESOLVER_IMAGE_TAG=v1.3.0
# 填写随机生成的管理员密码；浏览器登录用户名固定为 admin。
RESOLVER_ADMIN_KEY=
# 默认仅开放服务器本机，供 Nginx / 1Panel 反向代理连接。
# 仅局域网直连演示时可改为 0.0.0.0。
RESOLVER_BIND_ADDRESS=127.0.0.1
RESOLVER_PORT=4173
# 如需从局域网 CDS 拉取事件流，填写精确来源，多个用英文逗号分隔。
# RESOLVER_FEED_ORIGINS=http://192.168.1.20:8080
RESOLVER_FEED_ORIGINS=

# 可选：允许的远程素材来源（精确 origin，逗号分隔），局域网或代理虚拟 DNS 时使用。
# 仅添加你信任的来源，例如 https://avatar.hydrooj.com
RESOLVER_MEDIA_ORIGINS=
