{
  "name": "icpc-resolver-web",
  "version": "1.3.0",
  "private": true,
  "description": "Node.js-driven web reimplementation of the ICPC Tools Resolver with a configuration dashboard.",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node --test tests/*.test.js",
    "check": "node scripts/check.mjs && npm run typecheck",
    "examples": "node scripts/generate-examples.mjs",
    "logos:sync": "node scripts/sync-school-logos.mjs",
    "smoke": "node scripts/smoke.mjs",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "dev:ui": "vite --host 127.0.0.1",
    "pretest": "npm run build",
    "test:e2e": "playwright test --grep-invert @visual",
    "test:visual": "playwright test --grep @visual",
    "test:media": "node scripts/test-browser-media.mjs"
  },
  "engines": {
    "node": ">=22.13"
  },
  "keywords": [
    "icpc",
    "resolver",
    "scoreboard",
    "滚榜"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "dependencies": {
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@reduxjs/toolkit": "^2.8.2",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "hls.js": "^1.7.4",
    "html2canvas": "^1.4.1",
    "lodash": "^4.18.1",
    "luxon": "^3.7.2",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-redux": "^9.2.0",
    "react-transition-state": "^2.3.1",
    "styled-components": "^5.3.11",
    "typescript": "^7.0.2",
    "usehooks-ts": "^3.1.1",
    "vite": "^8.3.5"
  }
}
