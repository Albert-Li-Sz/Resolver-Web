RESOLVER_ADMIN_KEY=
MEDIA_INTERNAL_KEY=
MEDIA_PUBLIC_HOST=
RESOLVER_BIND_ADDRESS=0.0.0.0
RESOLVER_PORT=9080
MEDIA_BIND_ADDRESS=0.0.0.0
RESOLVER_IMAGE=ghcr.io/albert-li-sz/resolver-web:main
MEDIA_WORKER_IMAGE=ghcr.io/albert-li-sz/resolver-web-media-worker:main
# 默认开放任意来源；限制策略、防火墙和反向代理由部署者配置。
RESOLVER_NETWORK_POLICY=open
RESOLVER_TRUST_PROXY=true
RESOLVER_ALLOWED_ORIGINS=
RESOLVER_SECURITY_HEADERS=false
# 可选：媒体反向代理地址；留空跟随浏览器访问的 IP / 域名。
MEDIA_BROWSER_BASE=
MEDIA_HLS_BASE=
MEDIA_ICE_HOSTS=

# 对外媒体端口；改动后重建容器即可，无需重建镜像。
MEDIA_RTSP_PORT=20001
MEDIA_RTMP_PORT=20002
MEDIA_SRT_PORT=20003
MEDIA_HLS_PORT=20004
MEDIA_WEBRTC_PORT=20005
MEDIA_ICE_PORT=20006
